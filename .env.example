# ===========================================
# LOCAL DEVELOPMENT
# ===========================================

# Review service port
PORT=3000

# API gateway port
GATEWAY_PORT=8080

# --- Database (local) ---
# Either set the discrete variables below, OR set DATABASE_URL further down.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moviereview
DB_USER=
DB_PASSWORD=

# Long random hex string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# TMDB v4 Read Access Token (starts with eyJ...)
TMDB_API_KEY=

# Comma-separated list of frontend origins allowed to call the API.
# Defaults to the common Live Server origins for local development.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ===========================================
# PRODUCTION (only set these when deploying)
# ===========================================

# Postgres connection string (e.g. from Neon).
# When set, this overrides the discrete DB_* variables above.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Gateway → Review Service URL (e.g. the deployed review service's URL).
# Only needed for the gateway in production.
# REVIEW_SERVICE_URL=https://your-review-service.onrender.com

# Shared secret between gateway and review service. Any long random string.
# When set on BOTH services, the review service rejects requests that don't
# carry a matching X-Internal-Secret header. This stops outsiders calling
# the review service directly even though it has a public URL.
# INTERNAL_SECRET=
